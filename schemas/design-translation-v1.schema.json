{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://descalzi.github.io/brickforge/schemas/design-translation-v1.schema.json",
 "title":"BrickForge design-to-catalogue translation map v1",
 "type":"object","additionalProperties":false,
 "required":["schema_version","description","roles","features"],
 "properties":{
  "schema_version":{"const":1},"description":{"type":"string"},
  "roles":{"type":"object","additionalProperties":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}},
  "features":{"type":"object","additionalProperties":{"type":"object","additionalProperties":false,"required":["required_capabilities"],"properties":{"required_capabilities":{"type":"array","items":{"type":"string"}},"forbidden_capabilities":{"type":"array","items":{"type":"string"}}}}}
 }
}