{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://descalzi.github.io/brickforge/schemas/design-spec-v1.schema.json",
  "title": "BrickForge design specification v1",
  "description": "A catalogue-independent description of the intended object. It deliberately contains no catalogue part IDs, placements or construction choices.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "design_id",
    "units",
    "components",
    "relationships",
    "constraints"
  ],
  "properties": {
    "negative_spaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dimensions_mm",
          "position_mm"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "dimensions_mm": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width",
              "depth",
              "height"
            ],
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "depth": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "position_mm": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "z"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "schema_version": {
      "const": 1
    },
    "design_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "units": {
      "const": "mm"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "from",
          "to"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "above",
              "below",
              "left_of",
              "right_of",
              "in_front_of",
              "behind",
              "attached_to",
              "aligned_with",
              "symmetric_to",
              "dimension_ratio"
            ]
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "tolerance_mm": {
            "type": "number",
            "minimum": 0
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "axis": {
            "enum": [
              "x",
              "y",
              "z"
            ]
          },
          "anchor": {
            "enum": [
              "min",
              "max",
              "center"
            ]
          },
          "from_anchor": {
            "enum": [
              "min",
              "max",
              "center"
            ]
          },
          "to_anchor": {
            "enum": [
              "min",
              "max",
              "center"
            ]
          },
          "offset_mm": {
            "type": "number"
          },
          "plane_mm": {
            "type": "number"
          },
          "ratio": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "from_axis": {
            "enum": [
              "width",
              "depth",
              "height"
            ]
          },
          "to_axis": {
            "enum": [
              "width",
              "depth",
              "height"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "dimension_ratio"
                }
              }
            },
            "then": {
              "required": [
                "ratio",
                "from_axis",
                "to_axis"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "above"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "axis"
                    ]
                  },
                  {
                    "required": [
                      "anchor"
                    ]
                  },
                  {
                    "required": [
                      "from_anchor"
                    ]
                  },
                  {
                    "required": [
                      "to_anchor"
                    ]
                  },
                  {
                    "required": [
                      "offset_mm"
                    ]
                  },
                  {
                    "required": [
                      "plane_mm"
                    ]
                  },
                  {
                    "required": [
                      "ratio"
                    ]
                  },
                  {
                    "required": [
                      "from_axis"
                    ]
                  },
                  {
                    "required": [
                      "to_axis"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "below"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "axis"
                    ]
                  },
                  {
                    "required": [
                      "anchor"
                    ]
                  },
                  {
                    "required": [
                      "from_anchor"
                    ]
                  },
                  {
                    "required": [
                      "to_anchor"
                    ]
                  },
                  {
                    "required": [
                      "offset_mm"
                    ]
                  },
                  {
                    "required": [
                      "plane_mm"
                    ]
                  },
                  {
                    "required": [
                      "ratio"
                    ]
                  },
                  {
                    "required": [
                      "from_axis"
                    ]
                  },
                  {
                    "required": [
                      "to_axis"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "left_of"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "axis"
                    ]
                  },
                  {
                    "required": [
                      "anchor"
                    ]
                  },
                  {
                    "required": [
                      "from_anchor"
                    ]
                  },
                  {
                    "required": [
                      "to_anchor"
                    ]
                  },
                  {
                    "required": [
                      "offset_mm"
                    ]
                  },
                  {
                    "required": [
                      "plane_mm"
                    ]
                  },
                  {
                    "required": [
                      "ratio"
                    ]
                  },
                  {
                    "required": [
                      "from_axis"
                    ]
                  },
                  {
                    "required": [
                      "to_axis"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "right_of"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "axis"
                    ]
                  },
                  {
                    "required": [
                      "anchor"
                    ]
                  },
                  {
                    "required": [
                      "from_anchor"
                    ]
                  },
                  {
                    "required": [
                      "to_anchor"
                    ]
                  },
                  {
                    "required": [
                      "offset_mm"
                    ]
                  },
                  {
                    "required": [
                      "plane_mm"
                    ]
                  },
                  {
                    "required": [
                      "ratio"
                    ]
                  },
                  {
                    "required": [
                      "from_axis"
                    ]
                  },
                  {
                    "required": [
                      "to_axis"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "in_front_of"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "axis"
                    ]
                  },
                  {
                    "required": [
                      "anchor"
                    ]
                  },
                  {
                    "required": [
                      "from_anchor"
                    ]
                  },
                  {
                    "required": [
                      "to_anchor"
                    ]
                  },
                  {
                    "required": [
                      "offset_mm"
                    ]
                  },
                  {
                    "required": [
                      "plane_mm"
                    ]
                  },
                  {
                    "required": [
                      "ratio"
                    ]
                  },
                  {
                    "required": [
                      "from_axis"
                    ]
                  },
                  {
                    "required": [
                      "to_axis"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "behind"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "axis"
                    ]
                  },
                  {
                    "required": [
                      "anchor"
                    ]
                  },
                  {
                    "required": [
                      "from_anchor"
                    ]
                  },
                  {
                    "required": [
                      "to_anchor"
                    ]
                  },
                  {
                    "required": [
                      "offset_mm"
                    ]
                  },
                  {
                    "required": [
                      "plane_mm"
                    ]
                  },
                  {
                    "required": [
                      "ratio"
                    ]
                  },
                  {
                    "required": [
                      "from_axis"
                    ]
                  },
                  {
                    "required": [
                      "to_axis"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "attached_to"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "axis"
                    ]
                  },
                  {
                    "required": [
                      "anchor"
                    ]
                  },
                  {
                    "required": [
                      "from_anchor"
                    ]
                  },
                  {
                    "required": [
                      "to_anchor"
                    ]
                  },
                  {
                    "required": [
                      "offset_mm"
                    ]
                  },
                  {
                    "required": [
                      "plane_mm"
                    ]
                  },
                  {
                    "required": [
                      "ratio"
                    ]
                  },
                  {
                    "required": [
                      "from_axis"
                    ]
                  },
                  {
                    "required": [
                      "to_axis"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "aligned_with"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "plane_mm"
                    ]
                  },
                  {
                    "required": [
                      "ratio"
                    ]
                  },
                  {
                    "required": [
                      "from_axis"
                    ]
                  },
                  {
                    "required": [
                      "to_axis"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "symmetric_to"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "anchor"
                    ]
                  },
                  {
                    "required": [
                      "from_anchor"
                    ]
                  },
                  {
                    "required": [
                      "to_anchor"
                    ]
                  },
                  {
                    "required": [
                      "offset_mm"
                    ]
                  },
                  {
                    "required": [
                      "ratio"
                    ]
                  },
                  {
                    "required": [
                      "from_axis"
                    ]
                  },
                  {
                    "required": [
                      "to_axis"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "dimension_ratio"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "axis"
                    ]
                  },
                  {
                    "required": [
                      "anchor"
                    ]
                  },
                  {
                    "required": [
                      "from_anchor"
                    ]
                  },
                  {
                    "required": [
                      "to_anchor"
                    ]
                  },
                  {
                    "required": [
                      "offset_mm"
                    ]
                  },
                  {
                    "required": [
                      "plane_mm"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "aligned_with"
                }
              },
              "anyOf": [
                {
                  "required": [
                    "anchor"
                  ]
                },
                {
                  "required": [
                    "from_anchor"
                  ]
                },
                {
                  "required": [
                    "to_anchor"
                  ]
                },
                {
                  "required": [
                    "offset_mm"
                  ]
                }
              ]
            },
            "then": {
              "required": [
                "axis"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "symmetric_to"
                }
              },
              "required": [
                "plane_mm"
              ]
            },
            "then": {
              "required": [
                "axis"
              ]
            }
          }
        ]
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_connected",
        "allow_intersections"
      ],
      "properties": {
        "require_connected": {
          "type": "boolean"
        },
        "allow_intersections": {
          "type": "boolean"
        },
        "max_parts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_search_nodes": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000000
        },
        "course_type": {
          "enum": [
            "brick",
            "plate",
            "auto"
          ]
        }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_colours": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "symmetry": {
          "enum": [
            "none",
            "bilateral",
            "radial"
          ]
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "geometry",
        "dimensions_mm",
        "position_mm",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "function": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "geometry": {
          "enum": [
            "rectangular_prism",
            "cylinder",
            "sphere",
            "extruded_profile",
            "planar_profile",
            "domed_cylinder"
          ]
        },
        "geometry_parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "axis": {
              "enum": [
                "x",
                "y",
                "z"
              ]
            },
            "diameter_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "radius_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "depth_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "outline_mm": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            },
            "extrusion_axis": {
              "enum": [
                "x",
                "z"
              ],
              "description": "World extrusion axis; defaults to z. Outline coordinates are X/Y when z, Z/Y when x. depth_mm is the extrusion length."
            }
          }
        },
        "dimensions_mm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "depth",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "depth": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "position_mm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "priority": {
          "enum": [
            "essential",
            "preferred",
            "optional"
          ]
        },
        "required_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "colour": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "enum": [
            "explicit",
            "inferred",
            "uncertain"
          ]
        },
        "fit_tolerance_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "description": "Explicit allowed nominal dimension deviation; zero means exact."
        },
        "position_tolerance_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 8,
          "description": "Explicit per-axis translation uncertainty; compatible interfaces may align within this bound. Zero fixes the position."
        },
        "orientation": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "up": {
              "enum": [
                "+x",
                "-x",
                "+y",
                "-y",
                "+z",
                "-z"
              ]
            },
            "forward": {
              "enum": [
                "+x",
                "-x",
                "+y",
                "-y",
                "+z",
                "-z"
              ]
            }
          },
          "description": "Required world directions of source-profile semantic up/forward faces. Forward on a slope points downhill. Unsupported frames are rejected."
        },
        "shape_tolerance_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 8,
          "description": "Explicit radial shape-error allowance for a stepped sphere/cylinder approximation. Zero retains exact source-shape matching; dimensions have their own tolerance."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "shape_tolerance_mm"
            ]
          },
          "then": {
            "properties": {
              "geometry": {
                "enum": [
                  "sphere",
                  "cylinder"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
